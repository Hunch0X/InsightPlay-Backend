# ---------- shared ----------
DATABASE_URL=postgres://insightplay:insightplay@postgres:5432/insightplay
REDIS_URL=redis://redis:6379

# ---------- API ----------
PORT=4000
AUTH_REQUIRED=false            # set true in production and provide JWT_SECRET
JWT_SECRET=
CORS_ORIGIN=*                  # comma separated list of frontend origins in production
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_GB=10

# ---------- worker: detection & tracking ----------
DETECTOR_WEIGHTS=yolo26m.pt    # replace with football-trained weights (classes: player, goalkeeper, referee, ball)
DETECTOR_CLASS_MAP=            # JSON {"0":"player","1":"goalkeeper","2":"referee","3":"ball"} when class names are not recognisable
ANALYSIS_FPS=10
IMGSZ=1280
DEVICE=                        # "" auto, "cpu", "0" for the first GPU
BALL_WEIGHTS=                  # optional dedicated ball model
BALL_TILING=false

# ---------- worker: identity ----------
JERSEY_OCR=none                # none | easyocr  (easyocr must be installed)
REID_ENCODER=color             # color | osnet

# ---------- worker: pitch calibration ----------
CALIBRATION_MODE=auto          # auto | manual | keypoint | none
PITCH_KEYPOINT_WEIGHTS=        # YOLO-pose model that outputs the landmarks in worker/pipeline/calibration.py default_layout()
PITCH_LAYOUT_PATH=

# ---------- worker: AI interpretation ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# Optional JSON overrides of any threshold in worker/config.py, e.g. {"sprint_kmh": 24.0, "control_dist": 0.8}
THRESHOLDS_JSON=
